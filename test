-- ================= REGISTRASI FITUR ================= --

local activeConnection = nil
local activeIndex = nil
local buttonRegistry = {}

local function registerFeature(idxCode, sysCode, title, desc, actionPrompt, telemetryProvider, actionFn)
	local navBtn = Instance.new("TextButton")
	navBtn.Size = UDim2.new(1, 0, 0, 34)
	navBtn.BackgroundColor3 = Color3.fromRGB(20, 22, 27)
	navBtn.BorderSizePixel = 0
	navBtn.Text = ""
	navBtn.AutoButtonColor = false
	navBtn.ZIndex = 2
	navBtn.Parent = NavList

	local btnCorner = Instance.new("UICorner")
	btnCorner.CornerRadius = UDim.new(0, 8)
	btnCorner.Parent = navBtn

	local selectIndicator = Instance.new("Frame")
	selectIndicator.Size = UDim2.new(0, 3, 0, 18)
	selectIndicator.Position = UDim2.new(0, 4, 0.5, -9)
	selectIndicator.BackgroundColor3 = Color3.fromRGB(245, 158, 11)
	selectIndicator.BorderSizePixel = 0
	selectIndicator.Visible = false
	selectIndicator.ZIndex = 3
	selectIndicator.Parent = navBtn

	local indCorner = Instance.new("UICorner")
	indCorner.CornerRadius = UDim.new(0, 4)
	indCorner.Parent = selectIndicator

	local indexLabel = Instance.new("TextLabel")
	indexLabel.Size = UDim2.new(0, 28, 1, 0)
	indexLabel.Position = UDim2.new(0, 12, 0, 0)
	indexLabel.Font = Enum.Font.RobotoMono
	indexLabel.TextSize = 10
	indexLabel.TextColor3 = Color3.fromRGB(115, 122, 136)
	indexLabel.TextXAlignment = Enum.TextXAlignment.Left
	indexLabel.Text = idxCode
	indexLabel.BackgroundTransparency = 1
	indexLabel.ZIndex = 3
	indexLabel.Parent = navBtn

	local itemTitle = Instance.new("TextLabel")
	itemTitle.Size = UDim2.new(1, -44, 1, 0)
	itemTitle.Position = UDim2.new(0, 40, 0, 0)
	itemTitle.Font = Enum.Font.RobotoMono
	itemTitle.TextSize = 11
	itemTitle.TextColor3 = Color3.fromRGB(230, 233, 240)
	itemTitle.TextXAlignment = Enum.TextXAlignment.Left
	itemTitle.Text = title
	itemTitle.BackgroundTransparency = 1
	itemTitle.ZIndex = 3
	itemTitle.Parent = navBtn

	table.insert(buttonRegistry, {
		Button = navBtn,
		Indicator = selectIndicator,
		Index = idxCode,
		TitleLabel = itemTitle
	})

	navBtn.MouseEnter:Connect(function()
		if activeIndex ~= idxCode then
			navBtn.BackgroundColor3 = Color3.fromRGB(28, 31, 38)
		end
	end)

	navBtn.MouseLeave:Connect(function()
		if activeIndex ~= idxCode then
			navBtn.BackgroundColor3 = Color3.fromRGB(20, 22, 27)
		end
	end)

	navBtn.MouseButton1Click:Connect(function()
		activeIndex = idxCode

		for _, item in ipairs(buttonRegistry) do
			if item.Index == idxCode then
				item.Button.BackgroundColor3 = Color3.fromRGB(32, 36, 45)
				item.Indicator.Visible = true
				item.TitleLabel.TextColor3 = Color3.fromRGB(245, 158, 11)
			else
				item.Button.BackgroundColor3 = Color3.fromRGB(20, 22, 27)
				item.Indicator.Visible = false
				item.TitleLabel.TextColor3 = Color3.fromRGB(230, 233, 240)
			end
		end

		TargetHeader.Text = "SUBSISTEM: " .. sysCode
		TargetName.Text = title
		DetailDesc.Text = desc
		TelemetryVal.Text = telemetryProvider()

		ExecuteBtn.Text = actionPrompt
		ExecuteBtn.TextColor3 = Color3.fromRGB(13, 14, 17)
		ExecuteBtn.BackgroundColor3 = Color3.fromRGB(245, 158, 11)
		ExecStroke.Color = Color3.fromRGB(245, 158, 11)

		if activeConnection then
			activeConnection:Disconnect()
		end

		activeConnection = ExecuteBtn.MouseButton1Click:Connect(function()
			actionFn()
			TelemetryVal.Text = telemetryProvider()
		end)
	end)
end

registerFeature(
	"[01]",
	"PHYS_HUMANOID_SPEED",
	"WALKSPEED_OVERRIDE",
	"Mengganti limit kecepatan linear pada instance Humanoid pemain ke 50 studs/detik.",
	"COMMIT // WALK_SPEED = 50",
	function()
		local hum = player.Character and player.Character:FindFirstChild("Humanoid")
