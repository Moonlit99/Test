registerFeature(
	"[03]",
	"ENGINE_LIGHTING_ENV",
	"ILLUMINATION_TOGGLE",
	"Menyetel nilai properti Lighting.Brightness ke 2 dan menonaktifkan layer GlobalShadows.",
	"EXECUTE // TOGGLE_LIGHTING",
	function()
		return Lighting.GlobalShadows and "SHADOWS_ON" or "ILLUM_MAX_NO_SHADOW"
	end,
	function()
		if Lighting.Brightness == 1 then
			Lighting.Brightness = 2
			Lighting.GlobalShadows = false
		else
			Lighting.Brightness = 1
			Lighting.GlobalShadows = true
		end
	end
)

registerFeature(
	"[04]",
	"SYS_HUMANOID_RESET",
	"PARAM_NORMALIZATION",
	"Mengembalikan seluruh parameter manipulasi fisik (WalkSpeed 16, JumpPower 50) ke nilai baku engine.",
	"EXECUTE // RESET_TO_DEFAULT",
	function()
		local hum = player.Character and player.Character:FindFirstChild("Humanoid")
		if hum and hum.WalkSpeed == 16 and hum.JumpPower == 50 then
			return "NOMINAL"
		end
		return "MODIFIED"
	end,
	function()
		local hum = player.Character and player.Character:FindFirstChild("Humanoid")
		if hum then
			hum.WalkSpeed = 16
			hum.JumpPower = 50
		end
	end
)

-- ================= SISTEM DRAG & RESTORE BEBAS SNAP-BACK ================= --

-- State tunggal agar drag MainFrame & MiniIcon tidak pernah bentrok
local activeDragTarget = nil -- "Main" atau "Icon"
local dragStartMouse = nil
local dragStartUDim = nil
local iconMoved = false

-- Hover & Click Tombol Close
CloseBtn.MouseEnter:Connect(function()
	CloseBtn.BackgroundColor3 = Color3.fromRGB(210, 50, 60)
	CloseBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
end)
CloseBtn.MouseLeave:Connect(function()
	CloseBtn.BackgroundColor3 = Color3.fromRGB(28, 31, 38)
	CloseBtn.TextColor3 = Color3.fromRGB(160, 168, 180)
end)
CloseBtn.MouseButton1Click:Connect(function()
	ScreenGui.Enabled = false
end)

-- Hover & Click Tombol Minimize
MinBtn.MouseEnter:Connect(function()
	MinBtn.BackgroundColor3 = Color3.fromRGB(38, 42, 52)
	MinBtn.TextColor3 = Color3.fromRGB(245, 158, 11)
end)
MinBtn.MouseLeave:Connect(function()
	MinBtn.BackgroundColor3 = Color3.fromRGB(28, 31, 38)
	MinBtn.TextColor3 = Color3.fromRGB(160, 168, 180)
end)

MinBtn.MouseButton1Click:Connect(function()
	activeDragTarget = nil -- Reset semua sesi drag
	-- Salin langsung UDim2 Position milik MainFrame ke MiniIcon (bebas bug AbsolutePosition)
	MiniIcon.Position = MainFrame.Position
	MainFrame.Visible = false
	MiniIcon.Visible = true
end)

-- Mulai Drag pada TopBar (MainFrame)
TopBar.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		activeDragTarget = "Main"
		dragStartMouse = input.Position
		dragStartUDim = MainFrame.Position
	end
end)

-- Mulai Drag / Klik pada MiniIcon
MiniIcon.InputBegan:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		activeDragTarget = "Icon"
		iconMoved = false
		dragStartMouse = input.Position
		dragStartUDim = MiniIcon.Position
	end
end)

-- Pergerakan Mouse Global
UserInputService.InputChanged:Connect(function(input)
	if not activeDragTarget then return end
	if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
		local delta = input.Position - dragStartMouse

		if activeDragTarget == "Main" then
			MainFrame.Position = UDim2.new(
				dragStartUDim.X.Scale,
				dragStartUDim.X.Offset + delta.X,
				dragStartUDim.Y.Scale,
				dragStartUDim.Y.Offset + delta.Y
			)
		elseif activeDragTarget == "Icon" then
			if math.abs(delta.X) > 4 or math.abs(delta.Y) > 4 then
				iconMoved = true
			end
			MiniIcon.Position = UDim2.new(
				dragStartUDim.X.Scale,
				dragStartUDim.X.Offset + delta.X,
				dragStartUDim.Y.Scale,
				dragStartUDim.Y.Offset + delta.Y
			)
		end
	end
end)

-- Selesai Klik / Lepas Mouse Global
UserInputService.InputEnded:Connect(function(input)
	if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
		if activeDragTarget == "Icon" and not iconMoved then
			-- Jika diklik tanpa digeser, salin UDim2 Position terkini dari MiniIcon ke MainFrame
			MainFrame.Position = MiniIcon.Position
			MiniIcon.Visible = false
			MainFrame.Visible = true
		end
		activeDragTarget = nil
	end
end)
